\def\hv@extern@runLATEX#1#2#3#4{% path-compiler-file-extension
  \hv@ex@typeout{running #1#2 #3#4}%
  \ShellEscape{#1#2\space #3#4}%
  \hv@ex@typeout{running #1dvips #3}%
  \ShellEscape{#1dvips\space #3.dvi}%
