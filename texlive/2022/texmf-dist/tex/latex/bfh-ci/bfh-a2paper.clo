\ProvidesExplFile{bfh-a2paper.clo}{2022/03/01}{2.1.2}{bfh-ci~size~adjustments~for~a2paper}
\cs_set:Nn \ptxcd_setup_title_sizes: {
	\cs_set:Nn \ptxcd_title_fontsize: {{64bp}{77bp}}
	\cs_set:Nn \ptxcd_subtitle_fontsize: {{19.5bp}{23.4bp}}
	\cs_set:Nn \ptxcd_department_fontsize: {{23bp}{27.6bp}}
}
\cs_set:Nn \ptxcd_setup_base_sizes: {
	\dim_gset:Nn \g_ptxcd_margin_dim {20mm}
	\dim_gset:Nn \g_ptxcd_rule_height_dim {4.5mm}
	\dim_gset:Nn \g_ptxcd_rule_arc_dim {1.2mm}
	\tl_if_empty:NT \g_ptxcd_fontsize_tl {\tl_gset:Nn \g_ptxcd_fontsize_tl {19.5pt}}
}
\endinput