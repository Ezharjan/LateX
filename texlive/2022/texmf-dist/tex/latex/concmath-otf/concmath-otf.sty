% Following Joseph Wright in https://tex.stackexchange.com/questions/451
\begingroup
  \edef\temp{%
    \endgroup
    \noexpand\setmathfont{Concrete Math}%
    [\unexpanded\expandafter{\the\CCMtoks}]%
  }
  \temp

