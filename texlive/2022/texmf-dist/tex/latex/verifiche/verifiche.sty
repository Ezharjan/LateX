        floor((\dimexpr\pagegoal-\pagetotal-.5\baselineskip\relax)/\spacedim)*\spacedim%
    }%
}%
\newcommand{\verifiche@initremaininghspace}{%
\pgfmathsetlength{\verifiche@remaininghspace}{%
    floor(\linewidth/\spacedim)*\spacedim%
}%
}%

