code = "substitute @AllLetters asterisk' by a.nulled;\012substitute @AllLetters exclam' by b.nulled;\012substitute asterisk' @AllLetters by a.nulled;\012substitute exclam' @AllLetters by b.nulled;\012substitute @ToRotundaR r' by r.rotunda;\012substitute @ToRotundaR racute' by r.rotunda.acute;\012substitute @ToRotundaR r.tilde' by r.rotunda.tilde; \012substitute @ToSwashG g' by g.swash;\012substitute g.swash g by g_g; \012substitute i i by markerone;\012substitute markerone' i by markertwo;\012substitute markerone' markerone by i_i.dotted;\012   substitute markerone' markertwo by i_i.dotted;\012   substitute markerone by i_i.dotted.final;\012   substitute markertwo i' by i_i.dotted.final;\012   substitute markertwo by i.dotted;\012substitute @HasTailed' @beaked by @Tailed;\012substitute c h' by h.simple;\012substitute c h_j' by h_j.simple;\012substitute @tailed l' by l.simple;\012substitute @tailed h' by h.simple;\012substitute @tailed h_j' by h_j.simple;\012substitute @tailed h.tilde' by h.simple.tilde;\012substitute @tailed w' by w.simple;\012substitute @tailed l_l' by l_l.simple;\012substitute @minims i' by i.dotted;\012substitute i' @minims by i.dotted;\012\012lookup INITIALI {\012ignore sub @AllLetters r' w;\012sub r' w  by r.init.alt;\012} INITIALI;\012\012lookup INITIAL {\012ignore sub @AllLetters @HasInitial';\012sub @HasInitial' by @Initialed;\012} INITIAL;\012ignore sub @HasFinal' @NotFinalForm;\012sub @HasFinal' by @Finaled;\012ignore sub e' r.rotunda' @AllLetters;\012sub e' r.rotunda' by e_r.final;\012sub s s.final by s_s.final;\012sub odieresis' d by odieresis.alt;\012substitute @tailed l.tilde.final' by l.tilde.final.simple;\012substitute l.tilde.final colon by l.tilde.final.simple;\012substitute @OtherFinalN n.final' by n.final.other;\012substitute k i.final by k_j;\012substitute h i.final by h_j;\012substitute h.simple i.final by h_j.simple;\012substitute i i.final by i_i.dotted.final;\012substitute c t_u_r by c_t.tur;\012substitute t t_u_r by t_t.tur;";
