customParameters = (
{
name = description;
value = "Aboensis is a paleographic font that is mainly based on the Codex Aboensis that is a law book written in Sweden in the 1430s. The Codex is written in a North European cursive book hand. The font contains several sets of initials and other medieval symbols that are accessed using OpenType features or ligature substitutions.";
},
{
name = license;
value = "Open Font License 1.1 with Reserved Font Name Aboensis";
},
{
name = licenseURL;
value = "http://scripts.sil.org/OTF";
}
);
