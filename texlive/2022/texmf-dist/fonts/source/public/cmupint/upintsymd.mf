 ..tension atleast 1 and atleast .8..{z5-z4}z5e;  % upper curve
bas:=stroke z5'e{z6-z5}..tension atleast.8 and atleast 1
 ..{(z6e-z5'e)xscaled 1.1}z6e...{left}z7e;  % lower curve
