y39=y29=y19=y9;y38=y28=y18=y8;y37=y27=y17=y7;
x11=x1+ddec;x13=x3+ddec;
x21=x11+ddec;x23=x13+ddec;
x31=x21+ddec;x33=x23+ddec;
y31=y21=y11=y1;y33=y23=y13=y3;
x5=x4=x6; lft x5r=hround(.5w-1.5ddec-.5curve);
top y3r=0; bot y7r=-d;
