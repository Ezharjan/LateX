        \fi
    \fi}

\newif\if@thesisekf@nochanged@supervisorcaption@
\@thesisekf@nochanged@supervisorcaption@true
\def\supervisorcaption#1{%
    \@thesisekf@nochanged@supervisorcaption@false%
