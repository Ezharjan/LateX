\renewcommand{\chaptermark}[1]{%
  \markboth{\chaptertitlename\ \SUF@HEAD@thechapter}{#1}}
  \ifsuftesi@article
    \renewcommand{\sectionmark}[1]{\markright{\SUF@HEAD@thesection.\ #1}}
      \else
