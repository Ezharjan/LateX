%   \phantom{Page} & \phantom{Macro} & \phantom{Index Result}\\[-2.5ex]
%   \rowcolor{grey}5 & \cmd{\Name\{foo\}}\dotfill \hbox{} &  bar, 1, 2, \textit{see also} foo\\
%   \rowcolor{grey}& & foo, 5\\
