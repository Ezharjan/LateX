              \@nameauth@Index{\@nameauth@csbc}%
                {\@nameauth@B\@nameauth@space%
                 \@nameauth@C|see{\@nameauth@Target}}%
              \csgdef{\@nameauth@csbc!PN}{}%
            \else
              \PackageWarning{nameauth}%
