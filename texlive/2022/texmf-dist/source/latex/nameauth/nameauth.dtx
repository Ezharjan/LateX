          {\@nameauth@B\@nameauth@space%
           \@nameauth@C|seealso{\@nameauth@Target}}%
        \csgdef{\@nameauth@csbc!PN}{}%
      \else
        \unless\if@nameauth@OldSee
          \unless\ifcsname\@nameauth@csbc!MN\endcsname
